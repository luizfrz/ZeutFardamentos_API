# Banco local (docker-compose.yml deste projeto)
DATABASE_URL="postgresql://zeut:zeut@localhost:5432/zeut?schema=public"
PORT=3333
# Origem do front-end liberada no CORS
WEB_ORIGIN=http://localhost:3000

# ── Produção (Vercel) ──
# DATABASE_URL  = string de conexão COM pooler (Neon: host terminado em -pooler) e ?sslmode=require
# DIRECT_DATABASE_URL = string de conexão direta, usada só por `prisma migrate deploy`
# WEB_ORIGIN    = URL do front (várias separadas por vírgula, ex.: https://zeut.vercel.app,https://zeut-git-main.vercel.app)
# DB_POOL_MAX   = conexões por instância (padrão 5)
# DIRECT_DATABASE_URL=
# DB_POOL_MAX=5
