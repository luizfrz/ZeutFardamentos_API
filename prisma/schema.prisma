generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClientType {
  PF
  PJ
  ORGAO
}

enum ContactKind {
  TELEFONE
  WHATSAPP
  INSTAGRAM
}

enum OrderStatus {
  NAO_INICIADO
  PENDENTE
  CONCLUIDO
}

enum MoldCategory {
  BLUSA
  ESTOJO_BOLSA
  OUTRO
}

model Client {
  id        String     @id @default(uuid())
  type      ClientType
  name      String
  document  String?    @unique // CPF é opcional (pessoa física); CNPJ é obrigatório para empresa/órgão (validado na API)
  address   Json?
  createdAt DateTime   @default(now())

  contacts Contact[]
  orders   Order[]
}

model Contact {
  id            String      @id @default(uuid())
  clientId      String
  kind          ContactKind
  value         String
  ownerName     String?
  ownerDocument String?
  position      Int         @default(0)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model Responsible {
  id        String   @id @default(uuid())
  name      String
  cpf       String?  @unique // opcional
  phone     String
  createdAt DateTime @default(now())

  orders Order[]
}

model SizeGrid {
  id          String   @id
  name        String
  description String
  sizes       String[]
  position    Int      @default(0)
}

model Mold {
  id            String       @id @default(uuid())
  category      MoldCategory
  name          String       @unique
  group         String?
  models        String[]
  gridIds       String[]
  hasSizes      Boolean      @default(false)
  variationOfId String?
  notes         String?
  pieceType     String? // vestuário: CIMA | BAIXO | INTEIRO
  properties    String[] // vestuário: características padrão (ex.: "Bolso no peito")
  size          String? // dimensão (estojos e bolsas), ex.: "6 Altura x 26 Comprimento"
  createdAt     DateTime     @default(now())

  variationOf Mold?  @relation("MoldVariation", fields: [variationOfId], references: [id])
  variations  Mold[] @relation("MoldVariation")
  items       OrderItem[]
}

model Order {
  id            String      @id @default(uuid())
  number        Int         @unique @default(autoincrement())
  name          String
  description   String?
  clientId      String
  responsibleId String
  deliveryDate  DateTime?   @db.Date
  status        OrderStatus @default(NAO_INICIADO)
  createdAt     DateTime    @default(now())
  deliveredAt   DateTime?   @db.Date
  links         Json        @default("[]")
  images        String[]
  totalValue    Int? // em centavos; opcional
  stages        String[] // etapas de produção concluídas (chaves de STAGES); opcional

  // Restrict: apagar um pedido nunca apaga o cliente, e um cliente com pedidos não pode ser apagado.
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  responsible Responsible @relation(fields: [responsibleId], references: [id], onDelete: Restrict)
  items       OrderItem[]
  payments    Payment[]

  @@index([status, deliveryDate])
  @@index([clientId])
}

model OrderItem {
  id       String  @id @default(uuid())
  orderId  String
  moldId   String
  model    String?
  color    String
  grids    Json?
  quantity Int?
  position Int     @default(0)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  mold  Mold  @relation(fields: [moldId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model Payment {
  id        String   @id @default(uuid())
  orderId   String
  amount    Int // centavos
  paidAt    DateTime @db.Date
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(USER)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}
